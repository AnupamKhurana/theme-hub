[Desktop Entry]
Name=Theme Hub
Comment=Switch seamlessly between handcrafted Linux desktop appearances or revert anytime
GenericName=Appearance & Theme Studio
Exec=theme-hub
Icon=io.github.themehub
Terminal=false
Type=Application
Categories=Settings;DesktopSettings;Utility;
Keywords=theme;appearance;mac;aesthetic;gnome;kde;plasma;wallpaper;dark-mode;
StartupNotify=true
StartupWMClass=io.github.themehub
Actions=Aesthetic;Mac;Revert;

[Desktop Action Aesthetic]
Name=Apply Modern Aesthetic Theme
Exec=theme-hub-cli apply aesthetic

[Desktop Action Mac]
Name=Apply macOS Sonoma Look
Exec=theme-hub-cli apply mac

[Desktop Action Revert]
Name=Revert to Stock Defaults
Exec=theme-hub-cli revert
