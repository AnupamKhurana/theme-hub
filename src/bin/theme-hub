#!/usr/bin/env python3
"""Launcher executable for Theme Hub GUI."""
import sys
import os

# Support development, user-level (both site-packages and dist-packages), and system paths
src_dir = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))
if src_dir not in sys.path:
    sys.path.insert(0, src_dir)

import glob
for p in [
    os.path.expanduser("~/.local/lib/python3/dist-packages"),
    os.path.expanduser("~/.local/lib/python3/site-packages"),
    "/usr/share/theme-hub/python",
    "/usr/local/share/theme-hub/python",
]:
    if os.path.isdir(p) and p not in sys.path:
        sys.path.append(p)

for pattern in ["~/.local/lib/python3.*/dist-packages", "~/.local/lib/python3.*/site-packages"]:
    for match in glob.glob(os.path.expanduser(pattern)):
        if match not in sys.path:
            sys.path.append(match)

from theme_hub.app import main

if __name__ == "__main__":
    sys.exit(main())
