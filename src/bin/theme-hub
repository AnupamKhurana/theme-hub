#!/usr/bin/env python3
"""Launcher executable for Theme Hub GUI."""
import sys
import os

# Support development, user-level, and system paths
user_pkg = os.path.expanduser("~/.local/lib/python3/dist-packages")
if os.path.isdir(user_pkg) and user_pkg not in sys.path:
    sys.path.insert(0, user_pkg)

src_dir = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))
if src_dir not in sys.path:
    sys.path.insert(0, src_dir)

from theme_hub.app import main

if __name__ == "__main__":
    sys.exit(main())
